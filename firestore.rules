rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 自分自身のユーザードキュメントのみ読み書き可能
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /couples/{coupleId} {
      // 招待コードでの検索(join前のユーザー)が必要なため、ログインしていれば読み取り可
      allow read: if request.auth != null;
      // 作成時は「自分1人だけ」のmemberUidsであることを必須にする
      allow create: if request.auth != null && request.resource.data.memberUids == [request.auth.uid];
      // 更新は既存メンバー本人による更新か、招待コードで自分を1人だけ追加するケースのみ許可
      allow update: if request.auth != null &&
        (resource.data.memberUids.hasAny([request.auth.uid]) ||
         request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]));

      // タスクはペアのメンバーのみ読み書き可能
      match /tasks/{taskId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberUids.hasAny([request.auth.uid]);
      }
    }
  }
}
